#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Kevin Monaghan
# SPDX-License-Identifier: MIT-0

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

printf '%s\n' 'running: cargo fmt --all -- --check'
cargo fmt --all -- --check

printf '%s\n' 'running: cargo clippy --all-targets --all-features --locked -- -D warnings'
cargo clippy --all-targets --all-features --locked -- -D warnings
